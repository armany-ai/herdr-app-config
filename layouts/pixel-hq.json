{
  "id": "root",
  "type": "row",
  "theme": "pixel-hq",
  "toast": "company-toast",
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "children": [
        {
          "id": "brand",
          "type": "block",
          "content": {
            "mod": "company-brand"
          },
          "size": {
            "px": 46
          },
          "window_drag": true
        },
        {
          "id": "sidebar-lists",
          "type": "column",
          "children": [
            {
              "id": "spaces",
              "type": "block",
              "content": {
                "mod": "company-spaces"
              },
              "size": {
                "px": 104
              },
              "min": 90
            },
            {
              "id": "agents",
              "type": "block",
              "content": {
                "mod": "company-agents"
              },
              "size": {
                "weight": 1
              },
              "min": 90
            }
          ]
        },
        {
          "id": "sidebar-footer",
          "type": "block",
          "content": {
            "mod": "company-brand",
            "props": {
              "footer": true
            }
          },
          "size": {
            "px": 62
          }
        }
      ],
      "size": {
        "px": 268
      },
      "min": 44,
      "max": 480,
      "background": {
        "gradient": [
          "#ffffff26",
          "#2227304d"
        ],
        "angle": 160
      },
      "border": {
        "width": 1,
        "color": "#f1b5c040"
      },
      "radius": 20,
      "resizable": false
    },
    {
      "id": "work",
      "type": "column",
      "children": [
        {
          "id": "tabs",
          "type": "block",
          "content": {
            "mod": "company-tabs"
          },
          "size": {
            "px": 36
          },
          "radius": 0,
          "window_drag": true
        },
        {
          "id": "work-body",
          "type": "row",
          "children": [
            {
              "id": "main",
              "type": "block",
              "content": {
                "tab": "active",
                "pane": {
                  "header": {
                    "content": {
                      "mod": "company-pane"
                    },
                    "reveal": "always",
                    "height": 40,
                    "position": "top"
                  },
                  "background": {
                    "gradient": [
                      "#ffffff1c",
                      "#2e344082"
                    ],
                    "angle": 160
                  },
                  "border": {
                    "width": 1,
                    "color": "#ffffff30"
                  },
                  "focus": {
                    "width": 1,
                    "color": "#db4661"
                  },
                  "radius": 20,
                  "gap": 8,
                  "lone": true
                }
              }
            },
            {
              "id": "panel",
              "type": "column",
              "children": [
                {
                  "id": "panel-body",
                  "type": "stack",
                  "children": [
                    {
                      "id": "files",
                      "type": "block",
                      "content": {
                        "mod": "files"
                      }
                    },
                    {
                      "id": "changes",
                      "type": "block",
                      "content": {
                        "mod": "changes"
                      }
                    }
                  ],
                  "active": "files"
                }
              ],
              "size": {
                "px": 368
              },
              "min": 280,
              "max": 900,
              "hidden": true
            }
          ],
          "padding": 8,
          "gap": 8
        },
        {
          "id": "status",
          "type": "block",
          "content": {
            "mod": "company-status"
          },
          "size": {
            "px": 28
          }
        }
      ],
      "gap": 8,
      "resizable": false
    }
  ],
  "background": {
    "gradient": [
      "#54384799",
      "#2e344099"
    ],
    "angle": 160
  },
  "padding": 8,
  "colors": {
    "accent": "#db4661",
    "chrome": "#2227304d",
    "canvas": "#2227304d",
    "background": "#2e34404d",
    "surface": "#262637",
    "raised": "#313244",
    "border": "#ffffff14",
    "hover": "#ffffff10",
    "selected": "#ffffff14"
  },
  "terminal_padding": [
    16,
    14
  ],
  "terminal_opacity": 0,
  "gap": 8,
  "divider": {
    "width": 0,
    "color": "#00000000"
  },
  "titlebar": "none",
  "traffic_lights": [
    12,
    16
  ],
  "window_blur": true
}
